#!/bin/zsh
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: gh-demo-batch-open <txt-file>" >&2
  exit 1
fi

output="$(gh-demo-batch "$@")"
printf '%s\n' "$output"

summary_path="$(printf '%s\n' "$output" | sed -n 's/^Saved summary: //p' | tail -n 1)"

if [[ -z "${summary_path:-}" ]]; then
  echo "Error: could not determine summary path from gh-demo-batch output" >&2
  exit 1
fi

open "$summary_path"
echo "Opened: $summary_path"
