#!/bin/zsh
set -euo pipefail

custom_title=""

usage() {
  echo "Usage: gh-demo-x [--title \"Custom Title\"] <github-repo-url> [extra note]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      shift
      if [[ $# -lt 1 ]]; then
        echo "Error: --title requires a value" >&2
        exit 1
      fi
      custom_title="$1"
      shift
      ;;
    --title=*)
      custom_title="${1#--title=}"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

repo_url="$1"
shift || true
extra_note="${*:-}"

if [[ ! "$repo_url" =~ ^https://github\.com/[^/]+/[^/]+/?$ ]]; then
  echo "Error: expected a GitHub repo URL like https://github.com/owner/repo" >&2
  exit 1
fi

slug="${repo_url#https://github.com/}"
slug="${slug%/}"
owner="${slug%%/*}"
repo="${slug##*/}"

vault_dir="${HOME}/Obsidian"
out_dir="${vault_dir}/GitHub 仓库闭环"
mkdir -p "$out_dir"

timestamp="$(date +%Y%m%d-%H%M%S)"
if [[ -n "$custom_title" ]]; then
  safe_title="$(printf '%s' "$custom_title" | tr '/' '_' | tr ':' '_' | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g; s/^ *//; s/ *$//')"
  out_file="${out_dir}/${safe_title}--${timestamp}.md"
else
  out_file="${out_dir}/${owner}-${repo}--${timestamp}.md"
fi
tmp_file="${out_file}.tmp"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/gh-demo-x.XXXXXX")"
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

repo_api="https://api.github.com/repos/${owner}/${repo}"
repo_json="${tmp_dir}/repo.json"
clone_dir="${tmp_dir}/repo"
facts_file="${tmp_dir}/facts.txt"
readme_api_json="${tmp_dir}/readme.json"
contents_api_json="${tmp_dir}/contents.json"
readme_api_err="${tmp_dir}/readme_api.err"
contents_api_err="${tmp_dir}/contents_api.err"
raw_readme_file="${tmp_dir}/README.raw"

metadata_ok="false"
clone_ok="false"
clone_error=""
readme_path=""
readme_excerpt=""
default_branch=""
head_commit=""
contents_ok="false"
readme_ok="false"
top_level_fallback=""
manifests_fallback=""
demo_hints_fallback=""
clone_source="none"
api_fallback_status="not_attempted"
api_fallback_error=""

if curl -fsSL -H "Accept: application/vnd.github+json" "$repo_api" -o "$repo_json" 2>/dev/null; then
  metadata_ok="true"
fi

symref_output="$(git ls-remote --symref "https://github.com/${owner}/${repo}.git" HEAD 2>/dev/null || true)"
if [[ -n "$symref_output" ]]; then
  default_branch="$(printf '%s\n' "$symref_output" | sed -n 's#^ref: refs/heads/\(.*\)[[:space:]]\+HEAD$#\1#p' | head -n 1)"
  head_commit="$(printf '%s\n' "$symref_output" | awk '/HEAD$/ && $1 !~ /^ref:/ {print $1; exit}')"
fi

if git clone --depth 1 --single-branch "https://github.com/${owner}/${repo}.git" "$clone_dir" >/dev/null 2>"${tmp_dir}/clone.err"; then
  clone_ok="true"
  clone_source="clone"
else
  clone_error="$(sed -n '1,20p' "${tmp_dir}/clone.err" | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g')"
fi

if [[ "$clone_ok" == "true" ]]; then
  readme_path="$(find "$clone_dir" -maxdepth 1 -type f \( -iname 'README*' -o -iname 'readme*' \) | head -n 1 || true)"
  if [[ -n "$readme_path" ]]; then
    readme_excerpt="$(python3 - "$readme_path" "$default_branch" "$owner" "$repo" <<'PY'
import re, sys, pathlib
path = pathlib.Path(sys.argv[1])
default_branch = sys.argv[2] or "main"
owner = sys.argv[3]
repo = sys.argv[4]
try:
    text = path.read_text(encoding='utf-8', errors='ignore')
except Exception:
    text = ''

raw_base = f"https://raw.githubusercontent.com/{owner}/{repo}/{default_branch}/"

def rewrite_md_image(match):
    alt = match.group(1)
    url = match.group(2).strip()
    if re.match(r"^[a-z]+://", url):
        return match.group(0)
    return f"![{alt}]({raw_base}{url})"

def rewrite_html_image(match):
    prefix, url, suffix = match.groups()
    if re.match(r"^[a-z]+://", url):
        return match.group(0)
    return f'{prefix}{raw_base}{url}{suffix}'

text = re.sub(r'!\[([^\]]*)\]\(([^)]+)\)', rewrite_md_image, text)
text = re.sub(r'(<img[^>]*src=["\'])([^"\']+)(["\'][^>]*>)', rewrite_html_image, text, flags=re.IGNORECASE)

text = re.sub(r'```.*?```', '[code omitted]', text, flags=re.DOTALL)
lines = [line.rstrip() for line in text.splitlines()]
filtered = []
for line in lines:
    stripped = line.strip()
    if stripped.startswith('![') or stripped.startswith('<img'):
        continue
    if 'raw.githubusercontent.com' in stripped:
        continue
    filtered.append(line)
snippet = "\n".join(filtered[:90]).strip()
print(snippet[:6000])
PY
)"
  fi
fi

if [[ "$clone_ok" != "true" ]]; then
  api_fallback_status="attempted"

  for candidate in README.md README.mdx README.rst README.txt readme.md readme.mdx readme.rst readme.txt; do
    raw_url="https://raw.githubusercontent.com/${owner}/${repo}/${default_branch:-main}/${candidate}"
    if curl -fsSL "$raw_url" -o "$raw_readme_file" 2>/dev/null; then
      readme_ok="true"
      if [[ "$clone_source" == "none" ]]; then
        clone_source="raw_readme_fallback"
      fi
      break
    fi
  done

  if [[ "$readme_ok" == "true" && -f "$raw_readme_file" ]]; then
    readme_excerpt="$(python3 - "$raw_readme_file" "$default_branch" "$owner" "$repo" <<'PY'
import re, sys, pathlib
path = pathlib.Path(sys.argv[1])
default_branch = sys.argv[2] or "main"
owner = sys.argv[3]
repo = sys.argv[4]
raw_base = f"https://raw.githubusercontent.com/{owner}/{repo}/{default_branch}/"
try:
    text = path.read_text(encoding='utf-8', errors='ignore')
except Exception:
    text = ''

def rewrite_md_image(match):
    alt = match.group(1)
    url = match.group(2).strip()
    if re.match(r"^[a-z]+://", url):
        return match.group(0)
    return f"![{alt}]({raw_base}{url})"

def rewrite_html_image(match):
    prefix, url, suffix = match.groups()
    if re.match(r"^[a-z]+://", url):
        return match.group(0)
    return f'{prefix}{raw_base}{url}{suffix}'

text = re.sub(r'!\[([^\]]*)\]\(([^)]+)\)', rewrite_md_image, text)
text = re.sub(r'(<img[^>]*src=["\'])([^"\']+)(["\'][^>]*>)', rewrite_html_image, text, flags=re.IGNORECASE)
text = re.sub(r'```.*?```', '[code omitted]', text, flags=re.DOTALL)
lines = [line.rstrip() for line in text.splitlines()]
filtered = []
for line in lines:
    stripped = line.strip()
    if stripped.startswith('![') or stripped.startswith('<img'):
        continue
    if 'raw.githubusercontent.com' in stripped:
        continue
    filtered.append(line)
snippet = "\n".join(filtered[:90]).strip()
print(snippet[:6000])
PY
)"
  fi

  if [[ "$readme_ok" != "true" ]] && curl -fsSL -H "Accept: application/vnd.github+json" "${repo_api}/readme" -o "$readme_api_json" 2>"$readme_api_err"; then
    readme_ok="true"
    clone_source="github_api_fallback"
  fi

  if curl -fsSL -H "Accept: application/vnd.github+json" "${repo_api}/contents" -o "$contents_api_json" 2>"$contents_api_err"; then
    contents_ok="true"
    clone_source="github_api_fallback"
  fi

  api_fallback_error="$(
    {
      sed -n '1,3p' "$readme_api_err" 2>/dev/null || true
      sed -n '1,3p' "$contents_api_err" 2>/dev/null || true
    } | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g; s/^ *//; s/ *$//'
  )"

  if [[ "$readme_ok" != "true" && "$contents_ok" != "true" ]]; then
    api_fallback_status="failed"
  elif [[ "$readme_ok" == "true" || "$contents_ok" == "true" ]]; then
    api_fallback_status="partial_or_ok"
  fi

  if [[ "$readme_ok" == "true" && -z "$readme_excerpt" ]]; then
    readme_excerpt="$(python3 - "$readme_api_json" "$default_branch" "$owner" "$repo" <<'PY'
import base64, json, pathlib, re, sys

path = pathlib.Path(sys.argv[1])
default_branch = sys.argv[2] or "main"
owner = sys.argv[3]
repo = sys.argv[4]
raw_base = f"https://raw.githubusercontent.com/{owner}/{repo}/{default_branch}/"

try:
    data = json.loads(path.read_text())
except Exception:
    data = {}

content = data.get("content", "")
encoding = data.get("encoding", "")
if encoding == "base64" and content:
    try:
        text = base64.b64decode(content).decode("utf-8", errors="ignore")
    except Exception:
        text = ""
else:
    text = ""

def rewrite_md_image(match):
    alt = match.group(1)
    url = match.group(2).strip()
    if re.match(r"^[a-z]+://", url):
        return match.group(0)
    return f"![{alt}]({raw_base}{url})"

def rewrite_html_image(match):
    prefix, url, suffix = match.groups()
    if re.match(r"^[a-z]+://", url):
        return match.group(0)
    return f'{prefix}{raw_base}{url}{suffix}'

text = re.sub(r'!\[([^\]]*)\]\(([^)]+)\)', rewrite_md_image, text)
text = re.sub(r'(<img[^>]*src=["\'])([^"\']+)(["\'][^>]*>)', rewrite_html_image, text, flags=re.IGNORECASE)
text = re.sub(r'```.*?```', '[code omitted]', text, flags=re.DOTALL)

lines = [line.rstrip() for line in text.splitlines()]
filtered = []
for line in lines:
    stripped = line.strip()
    if stripped.startswith('![') or stripped.startswith('<img'):
        continue
    if 'raw.githubusercontent.com' in stripped:
        continue
    filtered.append(line)

snippet = "\n".join(filtered[:90]).strip()
print(snippet[:6000])
PY
)"
  fi

  if [[ "$contents_ok" == "true" ]]; then
    readarray_output="$(python3 - "$contents_api_json" <<'PY'
import json, pathlib, sys

path = pathlib.Path(sys.argv[1])
try:
    data = json.loads(path.read_text())
except Exception:
    data = []

items = []
if isinstance(data, list):
    for item in data:
        name = item.get("name", "")
        kind = item.get("type", "")
        if not name:
            continue
        suffix = "/" if kind == "dir" else ""
        items.append(name + suffix)

manifests = []
for name in [
    "package.json", "pnpm-lock.yaml", "yarn.lock", "bun.lockb",
    "pyproject.toml", "requirements.txt", "Pipfile", "poetry.lock",
    "Cargo.toml", "go.mod", "Dockerfile", "docker-compose.yml",
    "docker-compose.yaml", "Makefile", "README.md"
]:
    if name in [item.get("name", "") for item in data if isinstance(item, dict)]:
        manifests.append(name)

demo_hints = []
for item in data:
    if not isinstance(item, dict):
        continue
    name = item.get("name", "")
    kind = item.get("type", "")
    lower = name.lower()
    if any(token in lower for token in ["demo", "example", "examples", "playground", "docs", "website", "web", "app"]):
        demo_hints.append(name + ("/" if kind == "dir" else ""))

print("TOP_LEVEL=" + ", ".join(sorted(items)[:80]))
print("MANIFESTS=" + ", ".join(manifests))
print("DEMO_HINTS=" + ", ".join(sorted(set(demo_hints))[:40]))
PY
)"
    top_level_fallback="$(printf '%s\n' "$readarray_output" | sed -n 's/^TOP_LEVEL=//p')"
    manifests_fallback="$(printf '%s\n' "$readarray_output" | sed -n 's/^MANIFESTS=//p')"
    demo_hints_fallback="$(printf '%s\n' "$readarray_output" | sed -n 's/^DEMO_HINTS=//p')"
  else
    top_level_fallback="(unavailable: clone failed and contents fallback unavailable)"
    manifests_fallback="(unavailable)"
    demo_hints_fallback="(unavailable)"
  fi
fi

python3 - "$repo_json" "$metadata_ok" "$clone_dir" "$clone_ok" "$default_branch" "$head_commit" "$clone_error" "$clone_source" "$top_level_fallback" "$manifests_fallback" "$demo_hints_fallback" "$api_fallback_status" "$api_fallback_error" > "$facts_file" <<'PY'
import json, pathlib, sys

repo_json, metadata_ok, clone_dir, clone_ok, default_branch, head_commit, clone_error, clone_source, top_level_fallback, manifests_fallback, demo_hints_fallback, api_fallback_status, api_fallback_error = sys.argv[1:]

meta = {}
if metadata_ok == "true":
    try:
        meta = json.loads(pathlib.Path(repo_json).read_text())
    except Exception:
        meta = {}

def p(label, value):
    print(f"{label}: {value}")

p("repo_url", meta.get("html_url") or "")
p("full_name", meta.get("full_name") or "")
p("description", (meta.get("description") or "").strip())
p("homepage", (meta.get("homepage") or "").strip())
p("language", meta.get("language") or "")
p("stars", meta.get("stargazers_count", ""))
p("forks", meta.get("forks_count", ""))
p("open_issues", meta.get("open_issues_count", ""))
p("default_branch", default_branch or meta.get("default_branch") or "")
p("head_commit", head_commit)
p("topics", ", ".join(meta.get("topics") or []))
p("license", (meta.get("license") or {}).get("spdx_id", ""))
p("archived", meta.get("archived", ""))
p("disabled", meta.get("disabled", ""))
p("created_at", meta.get("created_at", ""))
p("pushed_at", meta.get("pushed_at", ""))
p("clone_ok", clone_ok)
p("clone_source", clone_source)
p("clone_error", clone_error)
p("api_fallback_status", api_fallback_status)
p("api_fallback_error", api_fallback_error)

if clone_ok == "true":
    root = pathlib.Path(clone_dir)
    top_level = sorted(p.name + ("/" if p.is_dir() else "") for p in root.iterdir())
    manifests = []
    for name in [
        "package.json", "pnpm-lock.yaml", "yarn.lock", "bun.lockb",
        "pyproject.toml", "requirements.txt", "Pipfile", "poetry.lock",
        "Cargo.toml", "go.mod", "Dockerfile", "docker-compose.yml",
        "docker-compose.yaml", "Makefile", "README.md"
    ]:
        if (root / name).exists():
            manifests.append(name)
    demo_hints = []
    for pattern in ["demo", "example", "examples", "playground", "docs", "website", "web", "app"]:
        for path in root.glob(f"*{pattern}*"):
            demo_hints.append(path.name + ("/" if path.is_dir() else ""))
    p("top_level", ", ".join(top_level[:80]))
    p("manifests", ", ".join(manifests))
    p("demo_hints", ", ".join(sorted(set(demo_hints))[:40]))
else:
    p("top_level", top_level_fallback)
    p("manifests", manifests_fallback)
    p("demo_hints", demo_hints_fallback)
PY

read -r -d '' prompt <<EOF || true
你现在不是做“技术最小闭环判断”，而是做“自媒体选题体验前判断”。

请只基于下面这份【已验证事实卡】输出，不允许基于仓库名、组织名、常识去猜。缺失事实就明确说“无法判断”。

用户是一个偏提效的内容创作者，不是硬核技术博主。他的选题优先级如下：
- 最高优先级：能提高效率，且他自己可能真会用
- 高优先级：能提高效率，即使他自己不一定长期用，但很多打工人会用
- 次优先：好玩，但要足够轻、足够容易体验
- 低优先：硬核技术仓库

明确减分项：
- 需要很强技术背景才能讲清
- 很难跑起来
- 很难形成第一手细节
- 传播面窄，只能写给少数开发者

额外注意：
- 工具体验很重要，但工具体验差 != 仓库价值低
- 有些提示词库 / 方法库 / 原则库，即使不好“上手玩”，仍然可能有高传播价值
- 只有在天然存在对比对象时，才提“对比评测”

请严格按下面 9 项结构输出，不要增删大项：

1. 选题结论：值得写 / 待定 / 不值得写
2. 题材类型：提效工具 / 好玩轻工具 / 方法库 / 提示词库 / 框架认知 / 技术项目
3. 一句话题眼
4. 对用户的优先级：最高 / 高 / 次 / 低，并说明原因
5. 工具体验价值：高 / 中 / 低，并说明原因
6. 传播张力：高 / 中 / 低，并说明原因
7. 值得提及的设计亮点
8. 你必须亲自验证的点
9. 体验投入等级 + 最终动作：低 / 中 / 高 + 入池 / 先观察 / 放弃

硬约束：
- 如果事实不足，就明确说“事实不足，暂不建议进入体验阶段”
- 不要把“仓库跑不通”直接等同于“不值得写”；要判断是否仍有内容价值
- 如果工具体验弱，但它是高价值的方法库 / 提示词库 / 原则库，也要明确指出其内容价值
- 如果存在天然对比对象，可在“你必须亲自验证的点”里指出，但不要强行添加
- 体验投入等级只要粗分低 / 中 / 高，不要假装精确到分钟
- 不要复述 README，不要输出硬核技术长分析
- 不要输出客套话，不要复述任务

【已验证事实卡】
EOF

facts_content="$(cat "$facts_file")"
prompt+=$'\n'"$facts_content"

facts_summary="$(python3 - "$facts_file" <<'PY'
import pathlib, sys

path = pathlib.Path(sys.argv[1])
data = {}
for line in path.read_text(encoding='utf-8', errors='ignore').splitlines():
    if ': ' not in line:
        continue
    k, v = line.split(': ', 1)
    data[k.strip()] = v.strip()

shape = []
if data.get("language"):
    shape.append(data["language"])
if data.get("stars"):
    shape.append(f"{data['stars']} stars")
if data.get("clone_source"):
    shape.append(f"事实来源: {data['clone_source']}")

repo_kind = []
top_level = data.get("top_level", "")
manifests = data.get("manifests", "")
demo_hints = data.get("demo_hints", "")
if "README.md" in manifests and "package.json" not in manifests and "go.mod" not in manifests and "Cargo.toml" not in manifests and "pyproject.toml" not in manifests:
    repo_kind.append("文档型")
elif "package.json" in manifests or "go.mod" in manifests or "Cargo.toml" in manifests or "pyproject.toml" in manifests:
    repo_kind.append("代码型")
if demo_hints and demo_hints != "(unavailable)":
    repo_kind.append("含 demo/docs 线索")
if top_level and top_level != "(unavailable: clone failed and contents fallback unavailable)":
    repo_kind.append("目录已验证")

lines = []
if data.get("description"):
    lines.append(f"- 简述: {data['description']}")
if shape:
    lines.append(f"- 基本面: {' | '.join(shape)}")
if repo_kind:
    lines.append(f"- 仓库形态: {' / '.join(repo_kind)}")
if data.get("clone_ok") == "false":
    lines.append("- 运行态: clone 失败，但已进入降级抓取路径")
if data.get("api_fallback_status") not in ("", "not_attempted"):
    lines.append(f"- Fallback: {data['api_fallback_status']}")
if data.get("api_fallback_error"):
    lines.append(f"- 限制: {data['api_fallback_error'][:120]}")

print("\n".join(lines).strip())
PY
)"

if [[ -n "$readme_excerpt" ]]; then
  prompt+=$'\n\n【README 摘要（已截断）】\n'"$readme_excerpt"
fi

if [[ -n "$extra_note" ]]; then
  prompt+=$'\n\n【额外说明】\n'"$extra_note"
fi

hermes_out="${tmp_dir}/hermes.out"
hermes_clean="${tmp_dir}/hermes.clean"
hermes_err="${tmp_dir}/hermes.err"
hermes_ok="false"
session_line=""
session_id=""
failure_summary=""

if hermes chat -Q -q "$prompt" >"$hermes_out" 2>"$hermes_err"; then
  hermes_ok="true"
else
  session_line="$(grep -E '^session_id:' "$hermes_out" | tail -n 1 || true)"
  session_id="${session_line#session_id: }"
  session_id="${session_id## }"
  failure_summary="$(sed -n '1,20p' "$hermes_err" | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g; s/^ *//; s/ *$//')"

  if [[ -z "$failure_summary" && -n "$session_id" ]]; then
    failure_summary="$(grep -F "[$session_id]" ~/.hermes/logs/agent.log 2>/dev/null | tail -n 3 | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g; s/^ *//; s/ *$//')"
  fi

  if [[ -z "$failure_summary" ]]; then
    failure_summary="Hermes 未返回有效判断结果。请检查 provider 配置、额度或账单状态。"
  fi

  failure_summary="$(printf '%s' "$failure_summary" | python3 - <<'PY'
import re, sys
text = sys.stdin.read().strip()
patterns = [
    r"Error code:\s*\d+[^\n]*",
    r"Non-retryable client error:[^\n]*",
    r"Traceback \(most recent call last\):[^\n]*",
    r"[A-Za-z_]*Error:[^\n]*",
]
for pat in patterns:
    m = re.search(pat, text)
    if m:
        print(m.group(0))
        break
else:
    text = re.sub(r"\s+", " ", text).strip()
    print(text[:240] if text else "")
PY
)"
fi

if [[ "$hermes_ok" == "true" ]]; then
  python3 - "$hermes_out" "$hermes_clean" <<'PY'
import pathlib, re, sys

src = pathlib.Path(sys.argv[1])
dst = pathlib.Path(sys.argv[2])
text = src.read_text(encoding='utf-8', errors='ignore')

lines = []
for line in text.splitlines():
    if re.search(r'clarify timed out.*agent will decide', line, re.IGNORECASE):
        continue
    lines.append(line)

cleaned = "\n".join(lines).strip() + "\n"
dst.write_text(cleaned, encoding='utf-8')
PY
fi

formatted_result="${tmp_dir}/hermes.formatted"
if [[ "$hermes_ok" == "true" ]]; then
  python3 - "$hermes_clean" "$formatted_result" <<'PY'
import pathlib, re, sys

src = pathlib.Path(sys.argv[1])
dst = pathlib.Path(sys.argv[2])
text = src.read_text(encoding='utf-8', errors='ignore')

text = re.sub(r'^Proceeding with strict analysis.*$', '', text, flags=re.MULTILINE)
text = re.sub(r'^严格基于.*$', '', text, flags=re.MULTILINE)
text = re.sub(r'^事实充足.*$', '', text, flags=re.MULTILINE)
text = re.sub(r'^无法访问 GitHub 页面.*$', '', text, flags=re.MULTILINE)

lines = [line.rstrip() for line in text.splitlines() if line.strip()]
items = {}
current = None
for line in lines:
    m = re.match(r'^(\d+)\.\s*(.+)$', line)
    if m:
        current = int(m.group(1))
        items[current] = m.group(2).strip()
    elif current is not None:
        items[current] += "\n" + line.strip()

def split_title_body(s):
    if "：" in s:
        title, body = s.split("：", 1)
        return title.strip(), body.strip()
    return s.strip(), ""

def has_meaningful_content(value):
    value = (value or "").strip()
    if not value:
        return False
    normalized = re.sub(r'[*_`#>\-\s]+', '', value)
    return bool(normalized)

def fallback_markdown(raw_text):
    raw_lines = [line.rstrip() for line in raw_text.splitlines()]
    while raw_lines and not raw_lines[0].strip():
        raw_lines.pop(0)
    while raw_lines and not raw_lines[-1].strip():
        raw_lines.pop()
    body = "\n".join(raw_lines).strip()
    if not body:
        body = "事实已抓取，但模型未返回可用判断内容。"
    return "## 判断结果\n\n" + body + "\n"

def clean_body_text(value):
    value = (value or "").strip()
    value = re.sub(r'^\*+\s*', '', value)
    value = re.sub(r'\s*\*+$', '', value)
    value = value.strip()
    if not has_meaningful_content(value):
        return ""
    return value

def structured_section_markdown(idx, label, raw_value):
    raw_value = (raw_value or "").strip()
    if not has_meaningful_content(raw_value):
        return []

    title, body = split_title_body(raw_value)
    title = clean_body_text(title)
    body = clean_body_text(body)

    out = [f"### {idx}. {label}"]

    if idx in (1, 2):
        value = body or title
        if not has_meaningful_content(value):
            return []
        out.append(f"**{value}**")
        out.append("")
        return out

    if idx == 3:
        value = body or title
        if not has_meaningful_content(value):
            return []
        out.append(value)
        out.append("")
        return out

    if idx in (4, 5, 6, 9):
        lead = body or title
        if not has_meaningful_content(lead):
            return []
        lead = re.sub(r'\s+[—-]\s+', '\n\n', lead, count=1)
        parts = [p.strip() for p in lead.split("\n\n", 1)]
        first = clean_body_text(parts[0]) if parts else ""
        if not has_meaningful_content(first):
            return []
        out.append(f"**{first}**")
        out.append("")
        if len(parts) > 1 and has_meaningful_content(parts[1]):
            out.append("原因：")
            out.append("")
            sentences = [clean_body_text(s) for s in re.split(r'；', parts[1]) if clean_body_text(s)]
            if len(sentences) > 1:
                for s in sentences:
                    out.append(f"- {s}")
            elif sentences:
                out.append(sentences[0])
            out.append("")
        return out

    if idx == 7:
        value = body or title
        if value.startswith("："):
            value = value[1:].strip()
        bullets = [clean_body_text(s) for s in re.split(r'[；\n]+', value) if clean_body_text(s)]
        if not bullets:
            return []
        for b in bullets:
            out.append(f"- {b}")
        out.append("")
        return out

    if idx == 8:
        value = body or title
        if not has_meaningful_content(value):
            return []
        if "——" in value or "—" in value:
            value = re.sub(r'\s*[—-]\s*', '\n\n', value, count=1)
        parts = [p.strip() for p in value.split("\n\n", 1)]
        first = clean_body_text(parts[0]) if parts else ""
        if first:
            out.append(first)
            out.append("")
        if len(parts) > 1 and has_meaningful_content(parts[1]):
            bullets = [clean_body_text(s) for s in re.split(r'[；\n]+', parts[1]) if clean_body_text(s)]
            for b in bullets:
                out.append(f"- {b}")
            out.append("")
        return out if len(out) > 1 else []

    return []

def raw_fragment_lines(raw_text):
    result = []
    for line in raw_text.splitlines():
        stripped = line.strip()
        if not stripped:
            result.append("")
            continue
        if re.match(r'^\d+\.\s*', stripped):
            continue
        if stripped in labels.values():
            continue
        if re.match(r'^Proceeding with strict analysis', stripped):
            continue
        if re.match(r'^严格基于', stripped):
            continue
        if re.match(r'^事实充足', stripped):
            continue
        if re.match(r'^无法访问 GitHub 页面', stripped):
            continue
        if stripped == "原因：":
            continue
        result.append(line.rstrip())

    while result and not result[0].strip():
        result.pop(0)
    while result and not result[-1].strip():
        result.pop()
    return result

out = []
out.append("## 判断结果")
out.append("")

labels = {
    1: "选题结论",
    2: "题材类型",
    3: "一句话题眼",
    4: "对用户的优先级",
    5: "工具体验价值",
    6: "传播张力",
    7: "值得提及的设计亮点",
    8: "你必须亲自验证的点",
    9: "体验投入等级 + 最终动作",
}

structured_found = []
for idx in range(1, 10):
    raw = items.get(idx, "")
    header = labels[idx]
    section = structured_section_markdown(idx, header, raw)
    if section:
        out.extend(section)
        structured_found.append(idx)

raw_non_empty_count = sum(1 for idx in range(1, 10) if has_meaningful_content(items.get(idx, "")))
if raw_non_empty_count < 2:
    dst.write_text(fallback_markdown(text), encoding='utf-8')
else:
    raw_lines = raw_fragment_lines(text)
    if len(structured_found) >= 6:
        formatted = "\n".join(out).strip() + "\n"
        dst.write_text(formatted, encoding='utf-8')
    elif structured_found:
        hybrid = out[:]
        if raw_lines:
            if hybrid and hybrid[-1] != "":
                hybrid.append("")
            hybrid.append("### 原始判断片段")
            hybrid.append("")
            hybrid.extend(raw_lines)
        hybrid_text = "\n".join(hybrid).strip() + "\n"
        dst.write_text(hybrid_text, encoding='utf-8')
    else:
        fallback_lines = [
            "## 判断结果",
            "",
            "以下内容为 Hermes 原始判断片段，因结构化解析失败，保留原文供人工阅读：",
            "",
        ]
        fallback_lines.extend(raw_lines if raw_lines else ["事实已抓取，但模型未返回可用判断内容。"])
        dst.write_text("\n".join(fallback_lines).strip() + "\n", encoding='utf-8')
PY
fi

{
  echo "# GitHub 仓库选题判断"
  echo
  echo "- Repo: ${repo_url}"
  echo "- Generated: $(date '+%Y-%m-%d %H:%M:%S')"
  echo "- Stage: 选题体验前判断"
  echo "- README: ${repo_url}#readme"
  echo
  echo "## 事实摘要"
  echo
  printf '%s\n' "$facts_summary"
  echo
  if [[ "$hermes_ok" == "true" ]]; then
    cat "$formatted_result"
  else
    echo "## 判断结果"
    echo
    echo "AI 判断未生成。"
    echo
    echo "- 原因：${failure_summary}"
    if [[ -n "$session_id" ]]; then
      echo "- Hermes Session: ${session_id}"
    fi
    echo "- 结论：GitHub 事实已成功抓取，但模型阶段失败；当前文件仍可用作事实卡。"
  fi
} > "$tmp_file"

mv "$tmp_file" "$out_file"
echo "Saved: $out_file"
