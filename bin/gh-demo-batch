#!/bin/zsh
set -euo pipefail

dry_run="false"
skip_existing="false"
dedupe="true"
limit=""

usage() {
  echo "Usage: gh-demo-batch [--dry-run] [--limit N] [--skip-existing] [--no-dedupe] <txt-file>" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run="true"
      shift
      ;;
    --skip-existing)
      skip_existing="true"
      shift
      ;;
    --no-dedupe)
      dedupe="false"
      shift
      ;;
    --limit)
      shift
      if [[ $# -lt 1 ]]; then
        echo "Error: --limit requires a value" >&2
        usage
        exit 1
      fi
      limit="$1"
      shift
      ;;
    --limit=*)
      limit="${1#--limit=}"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

input_file="$1"

if [[ ! -f "$input_file" ]]; then
  echo "Error: file not found: $input_file" >&2
  exit 1
fi

vault_dir="${HOME}/Obsidian"
out_dir="${vault_dir}/GitHub 仓库闭环"
mkdir -p "$out_dir"

timestamp="$(date +%Y%m%d-%H%M%S)"
summary_file="${out_dir}/${timestamp}-batch-summary.md"
tmp_summary="${summary_file}.tmp"

count_total=0
count_done=0
count_skipped=0
count_failed=0
count_selected=0

typeset -A seen_urls

if [[ -n "$limit" && ! "$limit" =~ '^[0-9]+$' ]]; then
  echo "Error: --limit must be a non-negative integer" >&2
  exit 1
fi

extract_github_urls() {
  local line="$1"
  local matches url
  matches=("${(@f)$(printf '%s\n' "$line" | grep -oE 'https://github\.com/[[:alnum:]_.-]+/[[:alnum:]_.-]+(\.git)?' || true)}")

  for url in "${matches[@]}"; do
    url="${url%.git}"
    print -r -- "$url"
  done
}

existing_note_for() {
  local gh_url="$1"
  local slug owner repo
  slug="${gh_url#https://github.com/}"
  owner="${slug%%/*}"
  repo="${slug##*/}"
  local pattern="${out_dir}"/*-"${owner}"-"${repo}".md
  local matches=( ${~pattern}(N) )
  if (( ${#matches[@]} > 0 )); then
    printf '%s\n' "${matches[-1]}"
    return 0
  fi
  return 1
}

{
  echo "# GitHub 仓库批处理摘要"
  echo
  echo "- Source: ${input_file}"
  echo "- Generated: $(date '+%Y-%m-%d %H:%M:%S')"
  echo
  echo "## 处理结果"
  echo
} > "$tmp_summary"

while IFS= read -r line || [[ -n "$line" ]]; do
  url="$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"

  if [[ -z "$url" || "$url" == \#* ]]; then
    continue
  fi

  while IFS= read -r gh_url; do
    [[ -z "${gh_url:-}" ]] && continue

    if [[ "$dedupe" == "true" ]]; then
      if [[ -n "${seen_urls[$gh_url]:-}" ]]; then
        continue
      fi
      seen_urls[$gh_url]=1
    fi

    if [[ -n "$limit" && "$count_total" -ge "$limit" ]]; then
      break 2
    fi

    if [[ "$dry_run" == "true" ]]; then
      count_total=$((count_total + 1))
      echo "Would process: $gh_url"
      continue
    fi

    if [[ "$skip_existing" == "true" ]]; then
      if existing_path="$(existing_note_for "$gh_url")"; then
        count_skipped=$((count_skipped + 1))
        printf -- "- SKIP: %s\n  - Existing: %s\n\n" "$gh_url" "$existing_path" >> "$tmp_summary"
        echo "[skip] Existing: $gh_url"
        continue
      fi
    fi

    if [[ -n "$limit" && "$count_selected" -ge "$limit" ]]; then
      break 2
    fi

    count_selected=$((count_selected + 1))

    if [[ "$dry_run" == "true" ]]; then
      echo "[$count_selected] Would process: $gh_url"
      continue
    fi

    echo "[$count_selected] Processing: $gh_url"

    if output="$(gh-demo-x "$gh_url" 2>&1)"; then
      saved_path="$(printf '%s\n' "$output" | sed -n 's/^Saved: //p' | tail -n 1)"
      if [[ -n "${saved_path:-}" ]]; then
        count_done=$((count_done + 1))
        printf -- "- DONE: %s\n  - File: %s\n" "$gh_url" "$saved_path" >> "$tmp_summary"
      else
        printf -- "- WARN: %s\n  - Could not parse saved path\n" "$gh_url" >> "$tmp_summary"
      fi
    else
      count_failed=$((count_failed + 1))
      printf -- "- FAIL: %s\n  - Error captured during run\n" "$gh_url" >> "$tmp_summary"
    fi

    printf "\n" >> "$tmp_summary"
  done < <(extract_github_urls "$line")
done < "$input_file"

{
  echo "## 统计"
  echo
  echo "- Selected: ${count_selected}"
  echo "- Success: ${count_done}"
  echo "- Skipped: ${count_skipped}"
  echo "- Failed: ${count_failed}"
} >> "$tmp_summary"

mv "$tmp_summary" "$summary_file"
echo "Saved summary: $summary_file"
