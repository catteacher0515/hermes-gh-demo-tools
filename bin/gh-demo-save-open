#!/bin/zsh
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: gh-demo-save-open <github-repo-url> [extra note]" >&2
  exit 1
fi

output="$(gh-demo-save "$@")"
printf '%s\n' "$output"

saved_path="$(printf '%s\n' "$output" | sed -n 's/^Saved: //p' | tail -n 1)"

if [[ -z "${saved_path:-}" ]]; then
  echo "Error: could not determine saved file path from gh-demo-save output" >&2
  exit 1
fi

open "$saved_path"
echo "Opened: $saved_path"
