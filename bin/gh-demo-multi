#!/bin/zsh
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"

dry_run="false"

usage() {
  echo "Usage: gh-demo-multi [--dry-run] <github-repo-url> [more github-repo-urls ...]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run="true"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

vault_dir="${HOME}/Obsidian"
out_dir="${vault_dir}/GitHub 仓库闭环"
mkdir -p "$out_dir"

typeset -A seen_urls
repo_urls=()

for arg in "$@"; do
  if [[ ! "$arg" =~ ^https://github\.com/[^/]+/[^/]+/?$ ]]; then
    echo "Error: expected a GitHub repo URL like https://github.com/owner/repo" >&2
    echo "Bad input: $arg" >&2
    exit 1
  fi

  clean="${arg%/}"
  if [[ -n "${seen_urls[$clean]:-}" ]]; then
    continue
  fi
  seen_urls[$clean]=1
  repo_urls+=("$clean")
done

total="${#repo_urls[@]}"
done_count=0
failed_count=0

if [[ "$dry_run" == "true" ]]; then
  for url in "${repo_urls[@]}"; do
    echo "Would process: $url"
  done
  exit 0
fi

for url in "${repo_urls[@]}"; do
  echo "==== Processing: $url ===="
  if output="$("$script_dir/gh-demo-x" "$url" 2>&1)"; then
    done_count=$((done_count + 1))
    printf '%s\n' "$output"
  else
    failed_count=$((failed_count + 1))
    printf '%s\n' "$output" >&2
  fi
  echo
done

echo "Batch complete: ${done_count} succeeded, ${failed_count} failed."
